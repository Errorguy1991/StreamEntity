<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0b0d"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Brand & In-App Server Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STREAM ENTITY"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="🟢 In-App Server: Active"
                android:textColor="#30D158"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Speed & Swarm Telemetry Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvDownloadSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_badge"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="↓ 0.0 MB/s"
                android:textColor="#30D158"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvUploadSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_badge"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="↑ 0.0 KB/s"
                android:textColor="#0A84FF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvPeers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_badge"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="👥 0 peers"
                android:textColor="#EBEBF5"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Native ExoPlayer Card -->
        <FrameLayout
            android:id="@+id/playerContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:layout_marginBottom="16dp">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:show_buffering="always"
                app:use_controller="true" />

            <!-- Empty State Overlay -->
            <LinearLayout
                android:id="@+id/emptyStateView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬"
                    android:textSize="36sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stream Entity"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paste any magnet link below to stream 4K/1080p sequentially"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Buffering Spinner -->
            <ProgressBar
                android:id="@+id/bufferingProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Stream Info Card (Visible when streaming) -->
        <LinearLayout
            android:id="@+id/cardStreamInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStreamTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Title"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvStreamDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connecting to swarm..."
                android:textColor="#8E8E93"
                android:textSize="11.5sp"
                android:layout_marginTop="3dp" />

            <ProgressBar
                android:id="@+id/progressBarStream"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progressTint="#30D158"
                android:max="100" />
        </LinearLayout>

        <!-- Magnet Input Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREAM FROM MAGNET"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Input Box (With Tap to Clear) -->
            <EditText
                android:id="@+id/etMagnetInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="Paste magnet link (magnet:?xt=urn:btih:...) here..."
                android:textColorHint="#636366"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnStreamNow"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_button"
                    android:text="▶ Stream Now"
                    android:textColor="#000000"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPaste"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_badge"
                    android:text="📋 Paste"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_glass_badge"
                    android:text="✕ Clear"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- Open in VLC / External Player -->
            <Button
                android:id="@+id/btnOpenExternalPlayer"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_badge"
                android:text="🎬 Open Stream in VLC / MX Player"
                android:textColor="#EBEBF5"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Native Donation Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DONATE · SUPPORT DEVELOPMENT"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chai Paani ka Kharcha 🍵 · Direct Creator Support"
                android:textColor="#636366"
                android:textSize="11.5sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp" />

            <!-- UPI Button -->
            <Button
                android:id="@+id/btnDonateUpi"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_glass_badge"
                android:text="⚡ Pay via UPI (GPay / PhonePe / Paytm) · vishalayu-3@oksbi"
                android:textColor="#30D158"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Revolut Button -->
            <Button
                android:id="@+id/btnDonateRevolut"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_glass_badge"
                android:text="💳 Donate via Revolut (@vr91)"
                android:textColor="#0A84FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Ko-fi Button -->
            <Button
                android:id="@+id/btnDonateKofi"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_glass_badge"
                android:text="☕ Donate on Ko-fi (ko-fi.com/vivescrn)"
                android:textColor="#FF9F0A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
