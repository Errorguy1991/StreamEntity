{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "cache/**",
      "android/**",
      "*.apk",
      "*.bat",
      "package.json",
      "package-lock.json",
      "README.md",
      "server.js",
      "engine.js",
      "scheduler.js",
      "vlc-launcher.js"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
